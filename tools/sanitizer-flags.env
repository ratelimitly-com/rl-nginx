# Shared compile and link instrumentation for rl-c-client, rl-nginx, and nginx.
# Keep warning/language flags separate because nginx supplies its own warning
# policy while the standalone C probes do not.
RN_SANITIZER_COMPILE_FLAGS="-O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer"
RN_SANITIZER_LINK_FLAGS="-fsanitize=address,undefined"
RN_SANITIZER_PROBE_FLAGS="-Wall -Wextra -std=c11"
